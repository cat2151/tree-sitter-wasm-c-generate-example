{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "musical_notes",
  "rules": {
    "source_file": {
      "type": "SYMBOL",
      "name": "note_sequence"
    },
    "note_sequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "note"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "-"
              },
              {
                "type": "SYMBOL",
                "name": "note"
              }
            ]
          }
        }
      ]
    },
    "note": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "C"
        },
        {
          "type": "STRING",
          "value": "D"
        },
        {
          "type": "STRING",
          "value": "E"
        },
        {
          "type": "STRING",
          "value": "F"
        },
        {
          "type": "STRING",
          "value": "G"
        },
        {
          "type": "STRING",
          "value": "A"
        },
        {
          "type": "STRING",
          "value": "B"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}